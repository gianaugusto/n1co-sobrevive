# Copy to .env (never commit it). Used by the backend, docker compose and the frontend build.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://forgetme:forgetme@localhost:5432/forgetme
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUESTS_TOPIC=forget.requests
KAFKA_FEEDBACK_TOPIC=forget.feedback
KAFKA_CONSUMER_GROUP=forgetme-orchestrator
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth0 (see docs/auth0-setup.md) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.forgetme.example

# --- Frontend build (docker compose) ---
VITE_API_URL=http://localhost:8000
VITE_AUTH0_CLIENT_ID=your-spa-client-id
